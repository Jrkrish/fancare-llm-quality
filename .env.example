# Copy to .env and fill in. Never commit .env.

# --- LLM: gemini | groq | ollama ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model override for the primary provider (defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash)
LLM_MODEL=
# Set to "ollama" to fall back to a local Ollama model when the primary provider fails.
# Leave empty during eval runs so every score comes from one model.
LLM_FALLBACK_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2

# --- Prompt / retriever ---
PROMPT_VERSION=v1            # v1 | v2 (weaker) | v3 (stricter)
RETRIEVER_MODE=hybrid        # hybrid | bm25 | vector
RERANK=true
RETRIEVAL_TOP_K=4
RERANK_MIN_SCORE=-4.0

# --- Tools: inject failures, e.g. get_order_status=timeout;check_warranty=malformed;*=empty ---
FAULT_INJECTION=
TOOL_TIMEOUT_S=3

# --- API ---
APP_API_KEY=dev-local-key
RATE_LIMIT_PER_MIN=30

# --- Observability ---
TRACE_DB_PATH=logs/traces.db
# Optional Langfuse (free cloud tier or self-hosted). Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Eval ---
# Judge model for DeepEval metrics (default in eval/config.toml: gemini / gemini-2.5-flash).
JUDGE_PROVIDER=
JUDGE_MODEL=
EVAL_RUNS=
# Space LLM requests to respect free-tier requests/minute (e.g. 2.0 = max 30/min).
LLM_MIN_INTERVAL_S=0
LLM_MAX_RETRIES=3
# Attempts per case for the safety / tool-use / conversation pytest suites, and reruns for flaky LLM tests.
SUITE_RUNS=1
FLAKY_RERUNS=1

# --- Optional extras ---
REPORTS_BUCKET=
ATHENA_DATABASE=
ATHENA_OUTPUT=
APPIUM_SERVER_URL=
ANDROID_APK=
