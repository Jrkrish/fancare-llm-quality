{
  "version": "1.0",
  "description": "Tool-use cases. expected_calls: tools that must be called with (at least) these arguments. forbid_tools: tools that must not be called. max_calls: upper bound on total tool calls. faults: injected failures. Every answer is also checked for order/warranty/ticket facts that no tool returned.",
  "cases": [
    {"id": "TU-01", "message": "Where is my order ORD-10001?",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10001"}}],
     "forbid_tools": ["create_support_ticket", "check_warranty", "recommend_product"], "max_calls": 2,
     "checks": {"must_contain_any": ["shipped"]}},
    {"id": "TU-02", "message": "What's the status of order ord-10002?",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10002"}}],
     "forbid_tools": ["create_support_ticket"], "max_calls": 2,
     "checks": {"must_contain_any": ["processing", "being prepared"]}},
    {"id": "TU-03", "message": "Has order ORD-99999 been delivered?",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-99999"}}],
     "forbid_tools": ["create_support_ticket"], "max_calls": 2,
     "checks": {"must_contain_any": ["couldn't find", "could not find", "not find", "no order", "not found", "doesn't exist", "does not exist", "unable to find"], "must_not_contain": ["delivered on"]}},
    {"id": "TU-04", "message": "Can you check the warranty on my fan, serial HU42-2502-00031?",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "HU42-2502-00031"}}],
     "forbid_tools": ["get_order_status", "create_support_ticket"], "max_calls": 2,
     "checks": {"must_contain_any": ["2030", "motor"]}},
    {"id": "TU-05", "message": "Is the receiver on my fan SW52-2403-00117 still under warranty?",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "SW52-2403-00117"}}],
     "forbid_tools": ["create_support_ticket"], "max_calls": 3,
     "checks": {"must_contain_any": ["expired", "no longer", "not covered", "ended", "isn't covered", "is not covered"]}},
    {"id": "TU-06", "message": "Recommend a quiet fan for my 120 sq ft bedroom. My budget is $250.",
     "expected_calls": [{"name": "recommend_product", "args": {"room_size": 120, "budget": 250, "needs": ["quiet"]}}],
     "forbid_tools": ["create_support_ticket", "get_order_status"], "max_calls": 3,
     "checks": {"must_contain_any": ["Hush 42", "HU42"]}},
    {"id": "TU-07", "message": "I need a fan for a 300 square foot outdoor patio, max $350.",
     "expected_calls": [{"name": "recommend_product", "args": {"room_size": 300, "budget": 350, "needs": ["outdoor"]}}],
     "forbid_tools": ["create_support_ticket"], "max_calls": 3,
     "checks": {"must_contain_any": ["TerraBreeze 60", "TB60"]}},
    {"id": "TU-08", "message": "Please open a support ticket: my fan shows E3 even after a power cycle.",
     "expected_calls": [{"name": "create_support_ticket", "args": {}}],
     "forbid_tools": ["get_order_status"], "max_calls": 3,
     "checks": {"must_contain_any": ["TKT-"]}},
    {"id": "TU-09", "message": "What does error E7 mean?",
     "expected_calls": [{"name": "search_docs", "args": {}}],
     "forbid_tools": ["get_order_status", "check_warranty", "recommend_product", "create_support_ticket"], "max_calls": 2,
     "checks": {"must_contain_any": ["firmware"]}},
    {"id": "TU-10", "message": "Where is my order?",
     "expected_calls": [],
     "forbid_tools": ["get_order_status", "create_support_ticket"], "max_calls": 1,
     "checks": {"expect_question": true, "must_contain_any": ["order ID", "order number", "ORD-"]}},
    {"id": "TU-11", "message": "Where is my order ORD-10001?", "faults": {"get_order_status": "timeout"}, "failure_type": "timeout",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10001"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "trouble"],
                "must_not_contain": ["shipped", "UPS-7Q4K92M1"]}},
    {"id": "TU-12", "message": "Where is my order ORD-10001?", "faults": {"get_order_status": "malformed"}, "failure_type": "malformed",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10001"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "trouble"],
                "must_not_contain": ["shipped", "UPS-7Q4K92M1"]}},
    {"id": "TU-13", "message": "Where is my order ORD-10001?", "faults": {"get_order_status": "empty"}, "failure_type": "empty",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10001"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "no information", "trouble"],
                "must_not_contain": ["shipped", "UPS-7Q4K92M1"]}},
    {"id": "TU-14", "message": "Check the warranty for serial TB60-2506-00208.", "faults": {"check_warranty": "timeout"}, "failure_type": "timeout",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "TB60-2506-00208"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "trouble"],
                "must_not_contain": ["2030-07-15", "2027-07-15"]}},
    {"id": "TU-15", "message": "Check the warranty for serial TB60-2506-00208.", "faults": {"check_warranty": "malformed"}, "failure_type": "malformed",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "TB60-2506-00208"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "trouble"],
                "must_not_contain": ["2030-07-15", "2027-07-15"]}},
    {"id": "TU-16", "message": "Check the warranty for serial TB60-2506-00208.", "faults": {"check_warranty": "empty"}, "failure_type": "empty",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "TB60-2506-00208"}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "no information", "trouble"],
                "must_not_contain": ["2030-07-15", "2027-07-15"]}},
    {"id": "TU-17", "message": "Recommend a fan for a 200 sq ft living room under $300.", "faults": {"recommend_product": "empty"}, "failure_type": "empty",
     "expected_calls": [{"name": "recommend_product", "args": {"room_size": 200, "budget": 300}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "trouble"]}},
    {"id": "TU-18", "message": "What does error E9 mean?", "faults": {"search_docs": "timeout"}, "failure_type": "timeout",
     "expected_calls": [{"name": "search_docs", "args": {}}], "max_calls": 3,
     "checks": {"must_contain_any": ["unavailable", "try again", "unable", "couldn't", "could not", "can't", "cannot", "not able", "don't have", "trouble"],
                "must_not_contain": ["110 to 130", "110-130"]}},
    {"id": "TU-19", "message": "My fan SW60-2508-00012 shows E3. Is it still covered? If not, please open a high-severity ticket.",
     "expected_calls": [{"name": "check_warranty", "args": {"serial_no": "SW60-2508-00012"}},
                        {"name": "create_support_ticket", "args": {"severity": "high"}}],
     "forbid_tools": ["get_order_status"], "max_calls": 4,
     "checks": {"must_contain_any": ["TKT-"]}},
    {"id": "TU-20", "message": "Where are my orders ORD-10001 and ORD-10003?",
     "expected_calls": [{"name": "get_order_status", "args": {"order_id": "ORD-10001"}},
                        {"name": "get_order_status", "args": {"order_id": "ORD-10003"}}],
     "forbid_tools": ["create_support_ticket"], "max_calls": 3,
     "checks": {"must_contain_all": ["shipped", "delivered"]}}
  ]
}
